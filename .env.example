# The real instance reads .env. `make up` creates it with random passwords when it is missing, and adds
# POSTGRES_API_PASSWORD, AUTH_SECRET_KEY, POSTGRES_COLLECTOR_PASSWORD or POSTGRES_LOGS_PASSWORD to a file that lacks it.
# It never changes or removes a line.

# The database owner's password. The owner holds the tables and runs the migrations; only the backend's
# entrypoint uses it. Letters and digits only: it is also part of a database URL.
# The database keeps the password it was first started with, so keep .env once the stack has run.
POSTGRES_PASSWORD=

# The password of megooitadmin_api, the restricted role the backend serves as. Letters and digits only.
# The backend sets it at every start, so a changed value takes effect at the next start.
POSTGRES_API_PASSWORD=

# The password of megooitadmin_collector, the restricted role the collector writes samples as. Letters and digits
# only. The backend sets it at every start.
POSTGRES_COLLECTOR_PASSWORD=

# The password of megooitadmin_logs, the restricted role the logs worker reads servers as. Letters and digits only.
# The backend sets it at every start.
POSTGRES_LOGS_PASSWORD=

# The key that encrypts the authenticator (TOTP) secrets: 64 hexadecimal characters (32 bytes). make up writes
# one. Keep it: without it the backend cannot check a code, so nobody can sign in.
AUTH_SECRET_KEY=

# Minutes without a request after which a session ends.
#SESSION_IDLE_MINUTES=60
# Minutes after sign-in after which a session ends, whatever happens.
#SESSION_ABSOLUTE_MINUTES=720
# Serve the API documentation at /api/docs and /api/openapi.json.
#API_DOCS=false
# Let webhooks use http:// URLs, only for test stacks: a real instance sends its webhooks over https.
#WEBHOOK_ALLOW_HTTP=false
# The most lines a log source sends per second. Lines above it are dropped and counted as skipped.
#LOG_STREAM_MAX_LINES_PER_SECOND=2000
# Minutes without activity in a log view after which its streams close.
#LOG_STREAM_IDLE_MINUTES=30

# Caddy's published port, the only port the stack opens. Put an address before it to listen on that
# address only, for example 127.0.0.1:8080. Use another port when 80 is taken or Docker is rootless.
#MEGOOITADMIN_HTTP_PORT=80

# The release the stack runs: latest follows every release (make upgrade pulls it). Set a version, for example
# 0.1.0, to stay on that release until you change this line.
#MEGOOITADMIN_VERSION=latest
